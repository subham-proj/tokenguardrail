{
  "name": "tokenguardrail",
  "version": "1.1.0",
  "description": "Know the cost of your LLM calls before and after you send them — with cache-aware pricing, budget guardrails, sessions, and pluggable sinks. Works with OpenAI, Anthropic, Google/Gemini, Mistral, and Groq.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subham-proj/tokenguardrail.git"
  },
  "homepage": "https://github.com/subham-proj/tokenguardrail#readme",
  "bugs": {
    "url": "https://github.com/subham-proj/tokenguardrail/issues"
  },
  "keywords": [
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "mistral",
    "groq",
    "cost",
    "pricing",
    "tokens",
    "tokenizer",
    "budget",
    "guardrail",
    "observability",
    "tiktoken"
  ],
  "author": "Subham Singh",
  "license": "ISC",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "openai": ">=4",
    "@anthropic-ai/sdk": ">=0.20",
    "@google/genai": ">=0.3",
    "@mistralai/mistralai": ">=1",
    "groq-sdk": ">=0.7"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "@mistralai/mistralai": {
      "optional": true
    },
    "groq-sdk": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "js-tiktoken": "^1.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "openai": "^4.77.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
